# ═══════════════════════════════════════════════════════════
# SHOPLIFTING TEST TOOL — CONFIG
# Copy this file to ".env" in the same folder as test_shoplifting.py
# ═══════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────
# CAMERA SOURCE
# ───────────────────────────────────────────────────────────
# Your camera's RTSP URL. Use "0" instead to test with a local webcam.
# CHANGE EFFECT: wrong URL / unreachable camera -> cap.isOpened() is False
# and the script exits immediately with an error.
# NOTE: webcam ("0") has different latency, frame rate, and encoding
# quality than RTSP -- results here won't fully represent production
# behavior. This also affects SHOPLIFT_CONCEAL_DWELL_FRAMES below, since
# that setting is frame-based, not time-based.
RTSP_URL=rtsp://username:password@camera-ip:554/Streaming/Channels/101

# ───────────────────────────────────────────────────────────
# MODEL PATHS
# CHANGE EFFECT: wrong path -> FileNotFoundError at startup, before the
# camera even opens. Using a different model version than the one running
# in production means results here won't reflect production behavior.
# ───────────────────────────────────────────────────────────
PERSON_MODEL=../ai-engine/models/person.onnx
SHOPLIFTING_MODEL=../ai-engine/models/shoplifting.onnx
POSE_MODEL=../ai-engine/models/pose.onnx

# ───────────────────────────────────────────────────────────
# DETECTION THRESHOLDS
# ───────────────────────────────────────────────────────────

# Minimum confidence to accept a "person" box.
# HIGHER -> fewer false persons, but risky: shoplifting_detector and
#   pose_estimator only run inside `if persons:` -- miss a real person here
#   and the WHOLE pipeline skips that frame, even during a real event.
# LOWER -> more false persons (shadows, mannequins), more GPU load since
#   downstream models get triggered more often.
PERSON_CONF=0.7

# Minimum confidence to accept a raw detection from the shoplifting CNN
# (before pose confirmation).
# HIGHER -> fewer confirmation windows open -> fewer false alarms, but
#   lower recall (real events below threshold are missed entirely).
# LOWER -> more windows open -> better chance of catching a real event,
#   but more pose_estimator calls (GPU load) and higher false-alarm risk.
SHOPLIFTING_CONF=0.5

# Minimum confidence to accept a person detection from the pose model.
# HIGHER -> if the person is at an odd angle or partly occluded, the pose
#   model may not detect them at all -> _find_pose() returns None ->
#   confirmation can NEVER happen for that person, even with an open
#   window and a valid CNN detection.
# LOWER -> weaker/noisier keypoints get accepted -> _wrist_in_zone() works
#   on unreliable data -> erratic true/false confirmations.
POSE_CONF=0.5

# IoU threshold used to remove overlapping duplicate boxes for the same
# object (Non-Max Suppression).
# HIGHER (closer to 1) -> more overlapping boxes survive -> duplicate boxes
#   for the same person/object.
# LOWER (closer to 0) -> more aggressive removal -> risk of merging/
#   dropping two people standing close together into one box.
NMS_THRESHOLD=0.3

# ───────────────────────────────────────────────────────────
# SHOPLIFTING CONFIRMATION GATE
# The magenta circle drawn on screen IS the SHOPLIFT_CONCEAL_ZONE_RADIUS_RATIO,
# to scale -- tune these while watching the live window.
# ───────────────────────────────────────────────────────────

# After a raw CNN detection, how many seconds the confirmation window stays
# open watching for a concealment hand movement.
# HIGHER -> longer time to catch a slow/hesitant concealment movement, but
#   any unrelated hand movement long after the original detection can still
#   confirm a false event -- the time link to the original trigger weakens.
# LOWER -> tighter temporal accuracy (movement must be close in time to the
#   original detection), but slow/hesitant concealment movements get missed.
SHOPLIFT_CONFIRM_WINDOW_SECONDS=2.5

# Radius of the "concealment zone" around the hip, as a ratio of torso
# length. This is the magenta circle in the video.
# HIGHER -> bigger circle -> easier for a hand to "reach" it -> higher
#   sensitivity (catches more real events), but ordinary movements
#   (adjusting a belt, hand in pocket, phone) trigger it too -> more false
#   positives.
# LOWER -> smaller circle -> hand must get very close to the hip -> higher
#   precision, but may miss concealment at a slightly different angle/distance.
SHOPLIFT_CONCEAL_ZONE_RADIUS_RATIO=0.35

# Number of CONSECUTIVE FRAMES the hand must stay inside the zone before
# the event is confirmed.
# HIGHER -> requires longer dwell -> filters out brief, unrelated movements
#   (a quick belt adjustment) -> higher precision, but may miss a fast, brief
#   concealment.
# LOWER -> confirms faster from a short movement -> higher sensitivity but
#   noisier (more false positives).
# !! IMPORTANT: this is FRAME-based, not TIME-based. 5 frames at 10 FPS is
#   ~0.5s, but 5 frames at 30 FPS is only ~0.17s. If the actual FPS during
#   this test (e.g. webcam) differs from actual production FPS (RTSP +
#   Docker + GPU load), the SAME number here produces DIFFERENT timing
#   behavior. Test on the same source type (RTSP) and similar load
#   conditions as production whenever possible.
SHOPLIFT_CONCEAL_DWELL_FRAMES=5

# ───────────────────────────────────────────────────────────
# FRAME SIZE
# Resolution each frame is resized to before entering the models.
# HIGHER -> finer detail (distant people, small hand movements detected
#   better) but LOWER FPS (more compute per frame), which directly affects
#   the real-world timing of SHOPLIFT_CONCEAL_DWELL_FRAMES above.
# LOWER -> higher FPS (faster), but less detail -> less reliable boxes/
#   keypoints -> less reliable concealment-zone decisions.
# ───────────────────────────────────────────────────────────
FRAME_WIDTH=640
FRAME_HEIGHT=480

# ───────────────────────────────────────────────────────────
# TENSORRT
# Controls the TensorrtExecutionProvider in resolve_providers().
# Same names/meaning as production ai-engine/.env.
# ───────────────────────────────────────────────────────────

# Master switch.
# true  -> try TensorRT first (falls back to CUDA if the TRT provider isn't
#   available on this machine, or to CPU if neither is). This is the
#   production code path.
# false -> force CUDA only. Not just a speed difference: TensorRT
#   (especially with TRT_FP16=true) uses different numeric precision and
#   kernel fusion, so confidence scores CAN differ slightly from CUDA/FP32
#   -- sometimes enough to flip a detection from below to above threshold
#   or vice versa. Use false only to isolate whether a bug is TRT-specific.
USE_TENSORRT=true

# Folder where ONNX Runtime caches the compiled .engine files.
# CHANGE EFFECT: the FIRST run after any model/threshold/precision change
#   is slow (30s to several minutes per model) while the engine is built
#   and written here. Every run after that reuses the cached file and
#   starts fast. Folder is created automatically if missing.
# !! COMMON TRAP: if you swap in a new model file with the SAME filename
#   without clearing this folder, TensorRT can load the OLD cached engine
#   that no longer matches the new model -> broken behavior or a crash.
#   Clear this folder whenever you change a model or a threshold that
#   affects engine building.
TRT_CACHE_DIR=./trt_cache

# Max GPU memory (bytes) TensorRT can use while building an engine.
# 2147483648 = 2GB, same default as production.
# LOWER -> engine build can fail with a workspace/memory error, or
#   TensorRT picks less-optimized (slower) kernels because it didn't have
#   room for the best ones.
# HIGHER -> better chance of a fast, well-optimized build, but risks
#   running out of GPU memory if something else is using the GPU at the
#   same time.
TRT_MAX_WORKSPACE=2147483648

# true  -> build the engine in FP16 (half precision). Faster, less GPU
#   memory, usually negligible accuracy loss.
# false -> full FP32 precision. Slower, more memory. Useful only when
#   debugging an accuracy discrepancy against CPU/FP32 results.
# MUST MATCH PRODUCTION EXACTLY -- if production runs true and you test
#   with false, results here won't reflect what actually happens in
#   production.
TRT_FP16=true